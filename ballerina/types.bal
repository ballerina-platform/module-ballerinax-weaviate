# The result of an aggregation. An ungrouped aggregation returns the flat form (`count` plus `tookMs`); a grouped aggregation returns `groups` plus `tookMs`. Exactly one of `count`/`groups` is present, except that a grouped aggregation which produced no groups (nothing matched, or no matching object carries the property) omits `groups` entirely
public type AggregateResponse record {
    # The number of matching objects. Present only for ungrouped aggregations
    int? count?;
    # The groups, ordered by descending count. Present only for grouped aggregations
    AggregateGroup[] groups?;
    # Server-side processing time in milliseconds
    int tookMs;
};

# A list of GraphQL queries
public type GraphQLQueries GraphQLQuery[];

# The definition of a backup create response body
public type BackupCreateResponse record {
    # Name of the bucket, container, volume, etc
    string bucket?;
    # Path within bucket of backup
    string path?;
    # The list of collections (classes) for which the backup creation process was started
    string[] classes?;
    # Backup backend name e.g. filesystem, gcs, s3
    string backend?;
    # The ID of the backup. Must be URL-safe and work as a filesystem path, only lowercase, numbers, underscore, minus characters allowed
    string id?;
    # error message if creation failed
    string 'error?;
    # phase of backup creation process
    "STARTED"|"TRANSFERRING"|"TRANSFERRED"|"FINALIZING"|"SUCCESS"|"FAILED"|"CANCELLING"|"CANCELED" status = "STARTED";
};

# The identity of one group: the `groupBy` property (as a one-element path) and the property value that formed the group
public type AggregateGroupedBy record {
    # The grouped property, as a one-element path
    string[] path;
    # The property value that formed the group. Typed as the property is: text values are strings, numeric values numbers, boolean values booleans; grouping by a reference property yields the reference's beacon URI as a string
    record {} value;
};

# Represents the Queries record for the operation: deleteObjectsBatch
public type DeleteObjectsBatchQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# List of roles
public type RolesListResponse Role[];

# Active distributed tasks by namespace
public type DistributedTasks record {|
    DistributedTask[]...;
|};

# Represents the Queries record for the operation: listAliases
public type ListAliasesQueries record {
    # Optional filter to retrieve aliases for a specific collection (class) only. If not provided, returns all aliases
    string 'class?;
};

# The metadata of a referenced object, populated according to the selector's `returnMetadata`. Every field is optional and only present when it was requested
public type SearchResultReferenceMetadata record {
    # The referenced object's creation time, as epoch milliseconds
    int? creationTime?;
    # The referenced object's UUID
    string? id?;
    # The referenced object's last-update time, as epoch milliseconds
    int? lastUpdateTime?;
};

# Request body for restoring a backup for a set of collections (classes)
public type BackupRestoreRequest record {
    # List of collections (classes) to include in the backup restoration process. Permits wildcards, e.g. `*` or `prefix*`. A list made only of wildcards that match no collection in the backup is rejected
    string[] include?;
    # List of collections (classes) to exclude from the backup restoration process
    string[] exclude?;
    # Allows overriding the node names stored in the backup with different ones. Useful when restoring backups to a different environment
    @jsondata:Name {value: "node_mapping"}
    record {|string...;|} nodeMapping?;
    # Backup custom configuration
    RestoreConfig config?;
    # Allows ovewriting the collection alias if there is a conflict
    boolean overwriteAlias?;
};

# Request to create a new export operation
public type ExportCreateRequest record {
    # List of collection names to include in the export. Cannot be used with 'exclude'
    string[] include?;
    # List of collection names to exclude from the export. Cannot be used with 'include'
    string[] exclude?;
    # Unique identifier for this export. Must be URL-safe
    string id;
    # Output file format for the export
    @jsondata:Name {value: "file_format"}
    "parquet" fileFormat;
};

public type AssignRoleToGroupRequest record {
    # If the group contains OIDC or database users
    GroupType groupType?;
    # The roles to assign to the specified group
    string[] roles?;
};

public type ObjectsGetResponseResultWrapper record {
    # Results for this specific object
    ObjectsGetResponseResult result?;
};

# (Response only) Additional meta information about a single object
public type AdditionalProperties record {|
    record {}...;
|};

public type IndexUpdateResponse record {
    string taskId?;
    # What the server did. `STARTED`: a reindex task was submitted and `taskId` names it. `CANCELLED`: a cancel stopped the in-flight task named by `taskId`. `NO_OP`: a cancel found nothing in flight, and `taskId` is absent. Not a closed set: a newer server may answer with a value this client does not know, so report an unrecognized status rather than rejecting the response
    string status?;
};

# Represents the Queries record for the operation: getCollectionObject
public type GetCollectionObjectQueries record {
    # Include additional information, such as classification information. Allowed values include: `classification`, `vector` and `interpretation`
    string include?;
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
    # The target node which should fulfill the request
    @http:Query {name: "node_name"}
    string nodeName?;
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# Delete Objects response
public type BatchDeleteResponse record {
    # Controls the verbosity of the output, possible values are: `minimal`, `verbose`. Defaults to `minimal`
    string output = "minimal";
    # If true, the call reported what the filter matched and deleted nothing. The list holds at most [`QUERY_MAXIMUM_RESULTS`](https://docs.weaviate.io/deploy/configuration/env-vars#QUERY_MAXIMUM_RESULTS) IDs. Defaults to false
    boolean dryRun = false;
    # Outlines how to find the objects to be deleted
    BatchDeleteMatch 'match?;
    # Timestamp of deletion in milliseconds since epoch UTC
    int? deletionTimeUnixMilli?;
    BatchDeleteResponseResults results?;
};

# Resources applicable for tenant actions
public type PermissionTenants record {
    # A string that specifies which collections this permission applies to. Can be an exact collection name or a regex pattern. The default value `*` applies the permission to all collections
    string collection = "*";
    # A string that specifies which tenants this permission applies to. Can be an exact tenant name or a regex pattern. The default value `*` applies the permission to all tenants
    string tenant = "*";
};

# resources applicable for replicate actions
public type PermissionReplicate record {
    # string or regex. if a specific collection name, if left empty it will be ALL or *
    string collection = "*";
    # string or regex. if a specific shard name, if left empty it will be ALL or *
    string shard = "*";
};

# Names and values of an individual property. A returned response may also contain additional metadata, such as from classification or feature projection
public type PropertySchema record {
};

# Reserved for reranking. Returns 422 (not yet supported)
public type SearchRerank record {
    # The query to rerank with. Defaults to the search query
    string query?;
    # The property to rerank on
    string property;
};

# Distributed task metadata
public type DistributedTask record {
    # The payload of the task
    record {} payload?;
    # The time when the task was created
    string startedAt?;
    # The nodes that finished the task
    string[] finishedNodes?;
    # The ID of the task
    string id?;
    # Units of the task. Only present for tasks that use unit tracking
    DistributedTaskUnit[] units?;
    # The high level reason why the task failed
    string 'error?;
    # The version of the task
    int version?;
    # The status of the task
    string status?;
    # The time when the task reached a terminal status. Absent while the task is still running
    string? finishedAt?;
};

# Multiple instances of references to other objects
public type MultipleRef SingleRef[];

public type DBUserInfo record {
    # Date and time in ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ
    string? createdAt?;
    # Date and time in ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ
    string? lastUsedAt?;
    # The roles associated with the user
    string[] roles;
    # Type of the returned user
    "db_user"|"db_env_user" dbUserType;
    # The namespace this user is bound to. Only populated for callers with global-operator privileges; omitted otherwise
    string namespace?;
    # Activity status of the returned user
    boolean active;
    # First 3 letters of the associated API key
    string? apiKeyFirstLetters?;
    # The name (ID) of the user
    string userId;
};

# The result of a REST search: the matched objects as `{id, properties, references, metadata}` envelopes, plus the server-side processing time. Shared by all REST search endpoints
public type SearchResponse record {
    # The matched objects, ordered by relevance
    SearchResultObject[] results;
    # Server-side processing time in milliseconds
    int tookMs;
};

public type Role record {
    Permission[] permissions;
    # The name (ID) of the role
    string name;
};

# Fields shared by every REST search request (near-text, bm25, hybrid, near-object). Unknown fields are ignored (platform parity with the other endpoints). Reserved fields are accepted by the schema but rejected by the server with 422 until the corresponding feature ships
public type SearchCommon record {
    # The retrieval metadata to return under each result's `metadata` key. The object `id` is always returned as each result's `id` field. Omitted or empty returns no `metadata` block
    ("distance"|"certainty"|"score"|"explainScore"|"creationTime"|"lastUpdateTime")[] returnMetadata?;
    # The number of objects to skip before returning results. Used with `limit` for pagination
    int? offset?;
    # The non-reference properties to return. Omitted returns all non-reference, non-blob properties; an empty array returns no properties. References are selected with `returnReferences`
    string[] returnProperties?;
    # Reserved for grouped search. Returns 422 (not yet supported)
    int? objectsPerGroup?;
    # Reserved for per-object retrieval-augmented generation. Returns 422 (not yet supported)
    string? singlePrompt?;
    # Reserved for grouped retrieval-augmented generation. Returns 422 (not yet supported)
    string? groupedTask?;
    # Reserved for grouped search. Returns 422 (not yet supported)
    string? groupBy?;
    # Reserved for reranking. Returns 422 (not yet supported)
    SearchRerank rerank?;
    # The maximum number of objects to return. Omitted or `0` falls back to the server default (`QUERY_DEFAULTS_LIMIT`); a value above `QUERY_MAXIMUM_RESULTS` is rejected
    int? 'limit?;
    # Cut results off at the first steep drop in score (autocut). The value is the number of score jumps to allow before cutting
    int? autoLimit?;
    # Reserved for grouped search. Returns 422 (not yet supported)
    int? numberOfGroups?;
    # Filter search results using a where filter
    WhereFilter 'where?;
    # The consistency level for the read
    "ONE"|"QUORUM"|"ALL" consistencyLevel?;
    # The cross-references to return under each result's `references` key. Each entry selects one reference property and what to return from the referenced objects. Omitted or empty returns no references
    SearchReferenceSelector[] returnReferences?;
    # The tenant to search in a multi-tenant collection
    string tenant?;
};

public type BatchReference record {
    # Long-form beacon-style URI to identify the source of the cross-reference, including the property name. Should be in the form of `weaviate://localhost/objects/<uuid>/<className>/<propertyName>`, where `<className>` and `<propertyName>` must represent the cross-reference property of the source class to be used
    string 'from?;
    # Short-form URI to point to the cross-reference. Should be in the form of `weaviate://localhost/<uuid>` for the example of a local cross-reference to an object
    string to?;
    # Name of the reference tenant
    string tenant?;
};

# Response object containing a list of alias mappings
public type AliasResponse record {
    # Array of alias objects, each containing an alias-to-collection mapping
    Alias[] aliases?;
};

# Represents a shard and lists the nodes that currently host its replicas
public type ReplicationShardReplicas record {
    string[] replicas?;
    string shard?;
};

public type CreateUserRequest record {
    # EXPERIMENTAL, DONT USE. THIS WILL BE REMOVED AGAIN. - import api key from static user
    boolean 'import = false;
    # EXPERIMENTAL, DONT USE. THIS WILL BE REMOVED AGAIN. - set the given time as creation time
    string createTime?;
};

# Resources applicable for data actions
public type PermissionData record {
    # A string that specifies which collections this permission applies to. Can be an exact collection name or a regex pattern. The default value `*` applies the permission to all collections
    string collection = "*";
    # A string that specifies which tenants this permission applies to. Can be an exact tenant name or a regex pattern. The default value `*` applies the permission to all tenants
    string tenant = "*";
    # Deprecated: Object-level permissions are not supported. This field is ignored; the permission always applies to all objects. Kept for backward compatibility
    string 'object = "*";
};

# Results for this specific Object
public type BatchDeleteResponseResultsObjects record {
    # The UUID of the object
    string id?;
    # An error response returned by Weaviate endpoints
    ErrorResponse errors?;
    "SUCCESS"|"DRYRUN"|"FAILED" status = "SUCCESS";
};

# Represents the Queries record for the operation: getUserRolesByType
public type GetUserRolesByTypeQueries record {
    # Whether to include detailed role information like its assigned permissions
    boolean includeFullRoles = false;
};

public type RoleUserAssignment record {
    # The type of the user. `db_user` users are created through the `users` API, `db_env_user` users are created through environment variables, and `oidc` users are managed by an external OIDC provider
    UserTypeOutput userType;
    string userId?;
};

# Results for this specific reference
public type BatchReferenceResponse_result record {
    # An error response returned by Weaviate endpoints
    ErrorResponse errors?;
    "SUCCESS"|"FAILED" status = "SUCCESS";
};

public type UpdateAliasRequest record {
    # The new collection (class) that the alias should point to
    string 'class?;
};

# A single search hit: the object's `id` (always returned), the selected non-reference properties under `properties`, the selected cross-references under `references`, and the requested retrieval metadata under `metadata`
public type SearchResultObject record {
    # The retrieval metadata of a single search hit, populated according to `returnMetadata`. Every field is optional and only present when it was requested and is computable for the search
    SearchResultMetadata metadata?;
    # The selected cross-references: reference property name to the array of referenced objects. Omitted when the request selects no references, or when the hit has no entry for any of the selected references
    record {|SearchResultReference[]...;|} references?;
    # The object's UUID. Always returned
    string id;
    # The selected non-reference properties of the object; nested (object / object[]) properties are pruned to the selected nested fields. Always present — `{}` when the request selects no properties
    record {|JsonObject...;|} properties;
};

# A batch of database-user credentials to recreate on the target, bound to a single target namespace
public type UserImportRequest record {
    # The target namespace every user in this request is created under. Required on namespace-enabled clusters
    string namespace?;
    # The credential records to import. Only records with a strong (argon2id) secureHash are importable
    DBUserCredential[] users;
};

# Represents the Queries record for the operation: deleteObject
public type DeleteObjectQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

public type AssignRoleToUserRequest record {
    # The roles that are assigned to the specified user
    string[] roles?;
    # The type of the user. `db` users are managed by Weaviate, `oidc` users are managed by an external OIDC provider
    UserTypeInput userType?;
};

# Request body for the near-text search endpoint. The query is vectorized server-side by the collection's vectorizer module and the closest objects are returned. Extends the shared search fields (`SearchCommon`) with the near-text-specific `query`, `certainty`, `distance` and `targetVector`
public type SearchNearTextRequest record {
    *SearchCommon;
    # Maximum vector distance of a match. Mutually exclusive with `certainty`
    decimal? distance?;
    # The concept(s) to search for, as an array of strings. Multiple entries perform a multi-concept search. A single concept is a one-element array, e.g. `["space opera"]`
    string[] query;
    # The named vector to search. Required when the collection has more than one named vector
    string targetVector?;
    # Minimum normalized certainty of a match. Only for cosine-distance vector indexes. Mutually exclusive with `distance`
    decimal? certainty?;
};

# Represents the Queries record for the operation: listNodes
public type ListNodesQueries record {
    # Controls the verbosity of the output, possible values are: `minimal`, `verbose`. Defaults to `minimal`
    string output = "minimal";
};

# The per-user outcome of an import batch
public type UserImportResponse record {
    UserImportResult[] results;
};

# Request body for the bm25 search endpoint. Performs a keyword (BM25F) search over the collection's searchable text properties and returns the best-scoring objects. Extends the shared search fields (`SearchCommon`) with the bm25-specific `query` and `queryProperties`
public type SearchBm25Request record {
    *SearchCommon;
    # The keyword query to score objects against, as a plain string. Must not be empty
    string query;
    # The properties to keyword-search, each optionally weighted with a `^boost` suffix (e.g. `title^2`). Omitted or empty searches every searchable text property. A property without a searchable index is rejected with 422
    string[] queryProperties?;
};

# Progress information for exporting a single shard
public type ShardProgress record {
    # Number of objects exported from this shard
    int objectsExported?;
    # Reason why this shard was skipped (e.g. tenant status)
    string skipReason?;
    # Error message if this shard's export failed
    string 'error?;
    # Status of this shard's export
    "TRANSFERRING"|"SUCCESS"|"FAILED"|"SKIPPED" status?;
};

public type RevokeRoleFromUserRequest record {
    # The roles to revoke from the specified user
    string[] roles?;
    # The type of the user. `db` users are managed by Weaviate, `oidc` users are managed by an external OIDC provider
    UserTypeInput userType?;
};

# GraphQL query based on: http://facebook.github.io/graphql/
public type GraphQLQuery record {
    # Additional variables for the query
    record {} variables?;
    # Query based on GraphQL syntax
    string query?;
    # The name of the operation if multiple exist in the query
    string operationName?;
};

# A list of GraphQL responses
public type GraphQLResponses GraphQLResponse[];

# This meta field contains additional info about the classified reference property
public type ReferenceMetaClassification record {
    # The lowest distance of a neighbor in the losing group. Optional. If k equals the size of the winning group, there is no losing group
    decimal? closestLosingDistance?;
    # overall neighbors checked as part of the classification. In most cases this will equal k, but could be lower than k - for example if not enough data was present
    decimal overallCount?;
    # size of the winning group, a number between 1..k
    decimal winningCount?;
    # Mean distance of all neighbors from the losing group. Optional. If k equals the size of the winning group, there is no losing group
    decimal? meanLosingDistance?;
    # Closest distance of a neighbor from the winning group
    decimal closestWinningDistance?;
    # deprecated - do not use, to be removed in 0.23.0
    decimal? losingDistance?;
    # size of the losing group, can be 0 if the winning group size equals k
    decimal losingCount?;
    # deprecated - do not use, to be removed in 0.23.0
    decimal winningDistance?;
    # The lowest distance of any neighbor, regardless of whether they were in the winning or losing group
    decimal closestOverallDistance?;
    # Mean distance of all neighbors from the winning group
    decimal meanWinningDistance?;
};

