public type ReplaceCollectionObjectReferencesQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# Update payload for an existing namespace
public type NamespaceUpdateRequest record {
    # Cluster node to use for future placements in this namespace. Must be a current storage candidate. Existing live shards are not moved
    @jsondata:Name {value: "home_node"}
    string homeNode;
};

# A vector representation of the object. If provided at object creation, this wil take precedence over any vectorizer setting
public type Vector record {
};

# Represents the Headers record for the operation: listTenants
public type ListTenantsHeaders record {
    # If true, the request is proxied to the cluster leader to ensure strong schema consistency. Default is true
    boolean consistency = true;
};

# Provides the UUIDs that were successfully force deleted as part of the replication operation. If dryRun is true, this will return the expected outcome without actually deleting anything
public type ReplicationReplicateForceDeleteResponse record {
    # The unique identifiers (IDs) of the replication operations that were forcefully deleted
    string[] deleted?;
    # Indicates whether the operation was a dry run (true) or an actual deletion (false)
    boolean dryRun?;
};

# Resources applicable for backup actions
public type PermissionBackups record {
    # A string that specifies which collections this permission applies to. Can be an exact collection name or a regex pattern. The default value `*` applies the permission to all collections
    string collection = "*";
};

# Response from the tokenize endpoints. Returns `indexed` text and text used at `query` time
public type TokenizeResponse record {
    # The tokens as they would be stored in the inverted index
    string[] indexed?;
    # The tokens as they would be used for query matching (e.g., after stopword removal)
    string[] query?;
};

# Current status of an export operation
public type ExportStatusResponse record {
    # Full path where the export is stored
    string path?;
    # When the export completed (successfully, with failure, or was canceled)
    string completedAt?;
    # List of collections in this export
    string[] classes?;
    # Per-shard progress: className -> shardName -> status
    record {|record {|ShardProgress...;|}...;|} shardStatus?;
    # When the export started
    string startedAt?;
    # The backend storage system used
    string backend?;
    # Unique identifier for this export
    string id?;
    # Error message if export failed
    string 'error?;
    # Duration of the export in milliseconds
    int tookInMs?;
    # Current status of the export
    "STARTED"|"TRANSFERRING"|"SUCCESS"|"FAILED"|"CANCELED" status?;
};

# GraphQL based response: http://facebook.github.io/graphql/
public type GraphQLResponse record {
    # GraphQL data object
    record {|JsonObject...;|} data?;
    # Array with errors
    GraphQLError[] errors?;
};

# Backup custom configuration
public type RestoreConfig record {
    # Path within the bucket
    @jsondata:Name {value: "Path"}
    string path?;
    # How users should be restored
    "noRestore"|"all" usersOptions = "noRestore";
    # name of the endpoint, e.g. s3.amazonaws.com
    @jsondata:Name {value: "Endpoint"}
    string endpoint?;
    # Name of the bucket, container, volume, etc
    @jsondata:Name {value: "Bucket"}
    string bucket?;
    # How roles should be restored
    "noRestore"|"all" rolesOptions = "noRestore";
    # Desired CPU core utilization ranging from 1%-80%
    @jsondata:Name {value: "CPUPercentage"}
    int cPUPercentage?;
};

# Provides a comprehensive overview of a specific replication operation, detailing its unique ID, the involved collection, shard, source and target nodes, transfer type, current status, and optionally, its status history
public type ReplicationReplicateDetailsReplicaResponse record {
    # Whether the replica operation can't be cancelled
    boolean uncancelable?;
    # An array detailing the historical sequence of statuses the replication operation has transitioned through, if requested and available
    ReplicationReplicateDetailsReplicaStatus[] statusHistory?;
    # The identifier of the node from which the replica is being moved or copied (the source node)
    string sourceNode;
    # The UNIX timestamp in ms when the replication operation was initiated. This is an approximate time and so should not be used for precise timing
    int whenStartedUnixMs?;
    # The unique identifier (ID) of this specific replication operation
    string id;
    # The name of the shard involved in this replication operation
    string shard;
    # The name of the collection to which the shard being replicated belongs
    string collection;
    # Indicates whether the operation is a `COPY` (source replica remains) or a `MOVE` (source replica is removed after successful transfer)
    "COPY"|"MOVE" 'type;
    # The identifier of the node to which the replica is being moved or copied (the target node)
    string targetNode;
    # Whether the replica operation is scheduled for cancellation
    boolean scheduledForCancel?;
    # Whether the replica operation is scheduled for deletion
    boolean scheduledForDelete?;
    # Represents the current or historical status of a shard replica involved in a replication operation, including its operational state and any associated errors
    ReplicationReplicateDetailsReplicaStatus status;
};

# A cluster-level namespace used to group resources under a common administrative unit. Namespace names must contain only lowercase letters, digits, and hyphens, must start and end with a letter or digit, must be 3-36 characters long, and must not be a reserved name
public type Namespace record {
    # The unique name of the namespace
    string name?;
    # Lifecycle state. "active" namespaces accept all operations. "suspended" namespaces reject new classes, aliases, users, roles, and role assignments, and their users can no longer authenticate; everything the namespace already owns is retained. "resuming" namespaces are on their way back to "active" and are still restricted the same way. "deleting" namespaces are being removed: new classes, aliases, and users can no longer be created in the namespace, and the namespace itself disappears once removal completes
    "active"|"suspended"|"resuming"|"deleting" state?;
    # The cluster node where this namespace's shards are placed. Set at create time and updatable later. Updating it only affects future placement decisions; existing live shards are not moved
    @jsondata:Name {value: "home_node"}
    string homeNode?;
};

# Represents the Queries record for the operation: getUser
public type GetUserQueries record {
    # Whether to include the last used time of the given user
    boolean includeLastUsedTime = false;
};

# Request body for creating a backup for a set of collections
public type BackupCreateRequest record {
    # List of collections to include in the backup creation process. If not set, all collections are included. Cannot be used together with `exclude`. Permits wildcards, e.g. `*` or `prefix*`. A list made only of wildcards that match no collection is rejected
    string[] include?;
    # List of RBAC roles to include in the backup. Permits `*` and `?` wildcards, e.g. `*` or `prefix*`. When omitted, the whole RBAC state is captured as part of the cluster snapshot; when set, the RBAC blob is filtered to the matching roles. An exact role name that does not exist is rejected; wildcards that match nothing back up no roles. Built-in roles are rejected and are never selected by wildcards (they are re-applied automatically on restore). No per-role permission check is applied
    string[] includeRoles?;
    # List of collections to exclude from the backup creation process. If not set, all collections are included. Cannot be used together with `include`. Permits wildcards, e.g. `*` or `prefix*`
    string[] exclude?;
    # The ID of the backup (required). Must be URL-safe and work as a filesystem path, only lowercase, numbers, underscore, minus characters allowed
    string id?;
    # List of dynamic DB users to include in the backup. Permits `*` and `?` wildcards, e.g. `*` or `prefix*`. When omitted, the whole dynamic-user store is captured as part of the cluster snapshot and no per-user permission check is applied; when set, only matching users are captured. An exact user name that does not exist is rejected; wildcards that match nothing back up no users
    string[] includeUsers?;
    # The ID of an existing backup to use as the base for a file-based incremental backup. If set, only files that have changed since the base backup will be included in the new backup
    @jsondata:Name {value: "incremental_base_backup_id"}
    string? incrementalBaseBackupId = "null";
    # Backup custom configuration
    BackupConfig config?;
};

public type GeoCoordinates record {
    # The latitude of the point on earth in decimal form
    float? latitude?;
    # The longitude of the point on earth in decimal form
    float? longitude?;
};

# If the group contains OIDC or database users
public type GroupType "oidc";

# Represents the Queries record for the operation: replaceObjectReferences
public type ReplaceObjectReferencesQueries record {
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# Resources applicable for role actions
public type PermissionRoles record {
    # A string that specifies which roles this permission applies to. Can be an exact role name or a regex pattern. The default value `*` applies the permission to all roles
    string role = "*";
    # Set the scope for the manage role permission
    "all"|"match" scope = "match";
};

# The definition of a backup restore metadata
public type BackupRestoreStatusResponse record {
    # Destination path of backup files valid for the selected backup backend, contains bucket and path
    string path?;
    # Backup backend name e.g. filesystem, gcs, s3
    string backend?;
    # The ID of the backup. Must be URL-safe and work as a filesystem path, only lowercase, numbers, underscore, minus characters allowed
    string id?;
    # Error message if backup restoration failed
    string 'error?;
    # Phase of backup restoration process
    "STARTED"|"TRANSFERRING"|"TRANSFERRED"|"FINALIZING"|"SUCCESS"|"FAILED"|"CANCELLING"|"CANCELED" status = "STARTED";
};

# Represents the Headers record for the operation: checkTenantExists
public type CheckTenantExistsHeaders record {
    # If true, the request is proxied to the cluster leader to ensure strong schema consistency. Default is true
    boolean consistency = true;
};

# Configuration of objects' time-to-live
public type ObjectTtlConfig record {
    # Name of the property holding base time to compute object's expiration time (ttl = value of deleteOn property + defaultTtl). Can be set to `_creationTimeUnix`, `_lastUpdateTimeUnix` or custom property of `date` datatype
    string deleteOn?;
    # Whether remove from resultset expired, but not yet deleted by background process objects (default: `false`)
    boolean filterExpiredObjects?;
    # Interval (in seconds) to be added to `deleteOn` value, denoting object's expiration time. Has to be positive for `deleteOn` set to `_creationTimeUnix` or `_lastUpdateTimeUnix`, any for custom property (default: `0`)
    int defaultTtl?;
    # Whether or not object ttl is enabled for this collection (default: `false`)
    boolean enabled?;
};

# Represents the Headers record for the operation: listCollections
public type ListCollectionsHeaders record {
    # If true, the request is proxied to the cluster leader to ensure strong schema consistency. Default is true
    boolean consistency = true;
};

public type BackupListResponseInner record {
    # Timestamp when the backup process completed (successfully or with failure)
    string completedAt?;
    # Size of the backup in Gibs
    decimal size?;
    # The list of collections (classes) for which the backup process was started
    string[] classes?;
    # Timestamp when the backup process started
    string startedAt?;
    # The ID of the backup. Must be URL-safe and work as a filesystem path, only lowercase, numbers, underscore, minus characters allowed
    string id?;
    # The ID of the base backup this incremental backup was built on; empty if the backup is not incremental
    @jsondata:Name {value: "incremental_base_backup_id"}
    string incrementalBaseBackupId?;
    # Status of backup process
    "STARTED"|"TRANSFERRING"|"TRANSFERRED"|"FINALIZING"|"SUCCESS"|"FAILED"|"CANCELLING"|"CANCELED" status?;
};

# Resources applicable for collection and/or tenant actions
public type PermissionCollections record {
    # A string that specifies which collections this permission applies to. Can be an exact collection name or a regex pattern. The default value `*` applies the permission to all collections
    string collection = "*";
};

# Allow custom overrides of vector weights as math expressions. E.g. `pancake`: `7` will set the weight for the word pancake to 7 in the vectorization, whereas `w * 3` would triple the originally calculated word. This is an open object, with OpenAPI Specification 3.0 this will be more detailed. See Weaviate docs for more info. In the future this will become a key/value (string/string) object
public type VectorWeights record {
};

# Represents the Headers record for the operation: getCollection
public type GetCollectionHeaders record {
    # If true, the request is proxied to the cluster leader to ensure strong schema consistency. Default is true
    boolean consistency = true;
};

# Either set beacon (direct reference) or set collection (class) and schema (concept reference)
public type SingleRef record {
    # Names and values of an individual property. A returned response may also contain additional metadata, such as from classification or feature projection
    PropertySchema schema?;
    # If using a direct reference, specify the URI to point to the cross-reference here. Should be in the form of weaviate://localhost/<uuid> for the example of a local cross-reference to an object
    string beacon?;
    # If using a direct reference, this read-only fields provides a link to the referenced resource. If 'origin' is globally configured, an absolute URI is shown - a relative URI otherwise
    string href?;
    # This meta field contains additional info about the classified reference property
    ReferenceMetaClassification classification?;
    # If using a concept reference (rather than a direct reference), specify the desired collection (class) name here
    string 'class?;
};

# Request body for the generic tokenize endpoint
public type TokenizeRequest record {
    # Optional user-defined named stopword presets. Shape matches InvertedIndexConfig.stopwordPresets on a collection: each key is a preset name, each value is a plain list of stopwords. A preset name that matches a built-in ('en', 'none') fully replaces the built-in. Preset names must not be empty or whitespace-only; each word list must contain at least one word; individual words must not be empty or whitespace-only. Mutually exclusive with stopwords — pass one or the other, not both
    record {|string[]...;|} stopwordPresets?;
    # The text to tokenize
    string text;
    # The tokenization method to apply
    "word"|"lowercase"|"whitespace"|"field"|"trigram"|"gse"|"kagome_kr"|"kagome_ja"|"gse_ch" tokenization;
    # Text analysis options for a property. These settings are immutable after the property is created. Applies only to text and text[] data types that use an inverted index (searchable or filterable)
    TextAnalyzerConfig analyzerConfig?;
    # Fine-grained control over stopword list usage
    StopwordConfig stopwords?;
};

# The outcome of importing a single database-user credential
public type UserImportResult record {
    # The reason, present only when status is 'error'
    string 'error?;
    # The name (ID) of the user, without any namespace prefix
    string userId;
    # The outcome for this user
    "created"|"reconciled"|"skipped_exists"|"error" status;
};

# Represents the Queries record for the operation: replaceCollectionObject
public type ReplaceCollectionObjectQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
};

# Represents the Queries record for the operation: listReplications
public type ListReplicationsQueries record {
    # Whether to include the history of the replication operation
    boolean includeHistory?;
    # The name of the collection to get details for
    string collection?;
    # The shard to get details for
    string shard?;
    # The name of the target node to get details for
    string targetNode?;
};

public type AddRolePermissionsRequest record {
    # Permissions to be added to the role
    Permission[] permissions;
};

public type Property record {
    # The properties of the nested object(s). Applies to object and object[] data types
    NestedProperty[] nestedProperties?;
    # Text analysis options for a property. These settings are immutable after the property is created. Applies only to text and text[] data types that use an inverted index (searchable or filterable)
    TextAnalyzerConfig textAnalyzer?;
    # Internal RAFT-replicated per-property flag: true iff this property's searchable (BM25) bucket is on the blockmax (StrategyInverted) index. Stamped at migration cutover. Absent/null means "not stamped" and is resolved against the class-wide UsingBlockMaxWAND flag. Internal use; clients must not set this
    boolean? searchableBlockmax?;
    # Data type of the property (required). If it starts with a capital (for example Person), may be a reference to another type
    string[] dataType?;
    # Description of the property
    string description?;
    # Internal RAFT-replicated counter bumped by semantic runtime-reindex migrations (e.g. change-tokenization, enable-filterable, enable-searchable). Used by the data path to resolve the property's inverted-index bucket name; a single RAFT commit flipping the schema flag AND bumping this counter atomically cuts the cluster from the old bucket to the new one. Defaults to 0. Internal use; clients should not set this
    int bucketGeneration?;
    # Whether to include this property in the filterable, Roaring Bitmap index. If `false`, this property cannot be used in `where` filters. 
    # 
    # Note: Unrelated to vectorization behavior
    boolean? indexFilterable?;
    # Determines how a property is indexed. This setting applies to `text` and `text[]` data types. The following tokenization methods are available:
    # 
    # - `word` (default): Splits the text on any non-alphanumeric characters and lowercases the tokens.
    # - `lowercase`: Splits the text on whitespace and lowercases the tokens.
    # - `whitespace`: Splits the text on whitespace. This tokenization is case-sensitive.
    # - `field`: Indexes the entire property value as a single token after trimming whitespace.
    # - `trigram`: Splits the property into rolling trigrams (three-character sequences).
    # - `gse`: Uses the `gse` tokenizer, suitable for Chinese language text. [See `gse` docs](https://pkg.go.dev/github.com/go-ego/gse#section-readme).
    # - `kagome_ja`: Uses the `Kagome` tokenizer with a Japanese (IPA) dictionary. [See `kagome` docs](https://github.com/ikawaha/kagome).
    # - `kagome_kr`: Uses the `Kagome` tokenizer with a Korean dictionary. [See `kagome` docs](https://github.com/ikawaha/kagome).
    # 
    # See [Reference: Tokenization](https://docs.weaviate.io/weaviate/config-refs/collections#tokenization) for details
    "word"|"lowercase"|"whitespace"|"field"|"trigram"|"gse"|"kagome_kr"|"kagome_ja"|"gse_ch" tokenization?;
    # Whether to include this property in the filterable, range-based Roaring Bitmap index. Provides better performance for range queries compared to filterable index in large datasets. Applicable only to properties of data type int, number, date
    boolean? indexRangeFilters?;
    # Configuration specific to modules in a collection context
    record {} moduleConfig?;
    # Optional. Should this property be indexed in the inverted index. Defaults to true. Applicable only to properties of data type text and text[]. If you choose false, you will not be able to use this property in bm25 or hybrid search. This property has no affect on vectorization decisions done by modules
    boolean? indexSearchable?;
    # The name of the property (required). Multiple words should be concatenated in camelCase, e.g. `nameOfAuthor`
    string name?;
    # If set to false, allows multiple references to the same target object within this property. Setting it to true will enforce uniqueness of references within this property. By default, this is set to true
    boolean? disableDuplicatedReferences = true;
    # (Deprecated). Whether to include this property in the inverted index. If `false`, this property cannot be used in `where` filters, `bm25` or `hybrid` search. 
    # 
    # Unrelated to vectorization behavior (deprecated as of v1.19; use indexFilterable or/and indexSearchable instead)
    boolean? indexInverted?;
};

# Text analysis options for a property. These settings are immutable after the property is created. Applies only to text and text[] data types that use an inverted index (searchable or filterable)
public type TextAnalyzerConfig record {
    # If true, accent/diacritic marks are folded to their base characters during indexing and search. For example, 'école' matches 'ecole'. Defaults to false
    boolean asciiFold?;
    # If provided, specifies a list of characters that should be excluded from ascii folding. For example, if ['é'] is provided, then 'é' will not be folded to 'e' during indexing and search. This list is immutable after the property is created
    string[] asciiFoldIgnore?;
    # Stopword preset name. Overrides the collection-level invertedIndexConfig.stopwords for this property. Only applies to properties using 'word' tokenization. Can be a built-in preset ('en', 'none') or a user-defined preset from invertedIndexConfig.stopwordPresets
    string stopwordPreset?;
};

# Resource definition for alias-related actions and permissions. Used to specify which aliases and collections can be accessed or modified
public type PermissionAliases record {
    # A string that specifies which aliases this permission applies to. Can be an exact alias name or a regex pattern. The default value `*` applies the permission to all aliases
    string alias = "*";
    # A string that specifies which collections this permission applies to. Can be an exact collection name or a regex pattern. The default value `*` applies the permission to all collections
    string collection = "*";
};

# Represents the Queries record for the operation: deleteObjectReference
public type DeleteObjectReferenceQueries record {
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# Contains the unique identifier for a successfully initiated asynchronous replica movement operation. This ID can be used to track the progress of the operation
public type ReplicationReplicateReplicaResponse record {
    # The unique identifier (ID) assigned to the registered replication operation
    string id;
};

# Represents the Queries record for the operation: listBackups
public type ListBackupsQueries record {
    # Order of returned list of backups based on creation time. (asc or desc)
    "asc"|"desc" 'order = "desc";
};

# Represents the Queries record for the operation: cancelBackup
public type CancelBackupQueries record {
    # Optional: Specifies the bucket, container, or volume name if required by the backend
    string bucket?;
    # Optional: Specifies the path within the bucket/container/volume if the backup is not at the root
    string path?;
};

# The type of the user. `db` users are managed by Weaviate, `oidc` users are managed by an external OIDC provider
public type UserTypeInput "db"|"oidc";

# A single database user's exportable API-key credential. Carries the argon2id key hash for strong-key users; for users whose key cannot be migrated (imported/weak, revoked, or missing a hash) secureHash is null and status names the reason
public type DBUserCredential record {
    # The argon2id PHC hash of the user's API key. Null when the key cannot be migrated (see status)
    string? secureHash?;
    # Date and time in ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ
    string createdAt?;
    # The random identifier embedded in the user's API key, used to resolve the key hash. Exactly 16 characters for an importable record; empty when the export reports a user whose key is not carried
    string userIdentifier?;
    # The namespace the user was bound to on the source. Informational on export; import binds the user to the request's target namespace
    string namespace?;
    # Whether the user is active. A deactivated (not revoked) user is carried with active=false and reproduced on import
    boolean active?;
    # First 3 letters of the associated API key
    @constraint:String {maxLength: 3}
    string apiKeyFirstLetters?;
    # The name (ID) of the user, without any namespace prefix
    string userId;
    # Export classification. Only 'exported' carries a usable secureHash; the others report why the user was not carried
    "exported"|"imported_key"|"revoked" status?;
};

public type UserApiKey record {
    # The API key associated with the user
    string apikey;
};

# The definition of a node shard status response body
public type NodeShardStatus record {
    # The load status of the shard
    boolean loaded?;
    # Minimum number of replicas for the shard
    int? replicationFactor?;
    # The number of objects in shard
    decimal objectCount?;
    # The status of the vector indexing process
    string vectorIndexingStatus?;
    # Number of replicas for the shard
    int? numberOfReplicas?;
    # The name of the shard
    string name?;
    # The length of the vector indexing queue
    decimal vectorQueueLength?;
    # The status of vector compression/quantization
    boolean compressed?;
    # The status of the async replication
    AsyncReplicationStatus[] asyncReplicationStatus?;
    # The name of shard's collection (class)
    string 'class?;
};

# Backup custom configuration
public type BackupConfig record {
    # Path or key within the bucket
    @jsondata:Name {value: "Path"}
    string path?;
    # Deprecated, has no effect
    @jsondata:Name {value: "ChunkSize"}
    int chunkSize?;
    # Name of the endpoint, e.g. s3.amazonaws.com
    @jsondata:Name {value: "Endpoint"}
    string endpoint?;
    # Name of the bucket, container, volume, etc
    @jsondata:Name {value: "Bucket"}
    string bucket?;
    # compression level used by compression algorithm
    @jsondata:Name {value: "CompressionLevel"}
    "DefaultCompression"|"BestSpeed"|"BestCompression"|"ZstdDefaultCompression"|"ZstdBestSpeed"|"ZstdBestCompression"|"NoCompression" compressionLevel = "DefaultCompression";
    # Desired CPU core utilization ranging from 1%-80%
    @jsondata:Name {value: "CPUPercentage"}
    int cPUPercentage?;
};

# Represents the Queries record for the operation: deleteCollectionObject
public type DeleteCollectionObjectQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
    # Specifies the tenant in a request targeting a multi-tenant collection (class)
    string tenant?;
};

# Request body for the near-object search endpoint. The stored vector of an existing object (the source object, referenced by `id`) anchors the search and the closest objects are returned. No query is vectorized — collections without a vectorizer module are fully searchable. Extends the shared search fields (`SearchCommon`) with the near-object-specific `id`, `certainty`, `distance` and `targetVector`
public type SearchNearObjectRequest record {
    *SearchCommon;
    # Maximum vector distance of a match. Mutually exclusive with `certainty`
    decimal? distance?;
    # The named vector to search (the source object's vector for this name anchors the search). Required when the collection has more than one named vector
    string targetVector?;
    # Minimum normalized certainty of a match. Only for cosine-distance vector indexes. Mutually exclusive with `distance`
    decimal? certainty?;
    # The UUID of the source object whose stored vector anchors the search. A structurally invalid UUID is rejected at request validation; a well-formed UUID that matches no object in the collection is rejected with 400
    string id;
};

# Represents an error encountered during a replication operation, including its timestamp and a human-readable message
public type ReplicationReplicateDetailsReplicaStatusError record {
    # The unix timestamp in ms when the error occurred. This is an approximate time and so should not be used for precise timing
    int whenErroredUnixMs?;
    # A human-readable message describing the error
    string message?;
};

# Tuning parameters for the BM25 algorithm
public type BM25Config record {
    # Calibrates term-weight scaling based on the document length (default: 0.75)
    float b?;
    # Calibrates term-weight scaling based on the term frequency within a document (default: 1.2)
    float k1?;
};

# Specifies the parameters required to initiate a shard replica movement operation between two nodes for a given collection and shard. This request defines the source and target node, the collection and type of transfer
public type ReplicationReplicateReplicaRequest record {
    # The name of the Weaviate node currently hosting the shard replica that needs to be moved or copied
    string sourceNode;
    # The name of the collection to which the target shard belongs
    string collection;
    # The name of the shard whose replica is to be moved or copied
    string shard;
    # Specifies the type of replication operation to perform. `COPY` creates a new replica on the target node while keeping the source replica. `MOVE` creates a new replica on the target node and then removes the source replica upon successful completion. Defaults to `COPY` if omitted
    "COPY"|"MOVE" 'type = "COPY";
    # The name of the Weaviate node where the new shard replica will be created as part of the movement or copy operation
    string targetNode;
};

# JSON object value
public type JsonObject record {
};

# Fine-grained control over stopword list usage
public type StopwordConfig record {
    # Stopwords to be considered additionally (default: []). Can be any array of custom strings
    string[] additions?;
    # Stopwords to be removed from consideration (default: []). Can be any array of custom strings
    string[] removals?;
    # Pre-existing list of common words by language (default: `en`). Options: [`en`, `none`]
    string preset?;
};

# The summary of a nodes batch queue congestion status
public type BatchStats record {
    # How many objects are currently in the batch queue
    decimal? queueLength?;
    # How many objects are approximately processed from the batch queue per second
    decimal ratePerSecond?;
};

public type DeactivateUserRequest record {
    # Whether the API key should be revoked when deactivating the user
    @jsondata:Name {value: "revoke_key"}
    boolean revokeKey = false;
};

public type TokenizerUserDictConfigReplacements record {
    # The string to be replaced
    string 'source;
    # The string to replace with
    string target;
};

# Configuration for asynchronous replication
public type ReplicationAsyncConfig record {
    # Maximum number of object keys included in a single diff batch
    int? diffBatchSize?;
    # Timeout in seconds for computing a diff against a single node
    int? diffPerNodeTimeout?;
    # Delay in milliseconds before newly added or updated objects are propagated
    int? propagationDelay?;
    # Frequency in milliseconds at which async replication runs while propagation is active
    int? frequencyWhilePropagating?;
    # Interval in seconds at which async replication logs its status
    int? loggingFrequency?;
    # Height of the hashtree used for diffing
    int? hashtreeHeight?;
    # Number of objects to include in a single propagation batch
    int? propagationBatchSize?;
    # Overall timeout in seconds for the pre-propagation phase
    int? prePropagationTimeout?;
    # Timeout in seconds for propagating batch of changes to a node
    int? propagationTimeout?;
    # Maximum number of objects to propagate in a single async replication run
    int? propagationLimit?;
    # Base frequency in milliseconds at which async replication runs diff calculations
    int? frequency?;
    # Maximum number of concurrent propagation workers
    int? propagationConcurrency?;
};

public type VectorConfig record {
    # Configuration of a specific vectorizer used by this vector
    record {} vectorizer?;
    # Vector-index config, that is specific to the type of index selected in vectorIndexType
    record {} vectorIndexConfig?;
    # Name of the vector index to use, eg. (HNSW)
    string vectorIndexType?;
};

# A vector representation of the object in the Contextionary. If provided at object creation, this wil take precedence over any vectorizer setting
public type C11yVector float[];

# List of objects
public type ObjectsListResponse record {
    # The total number of objects for the query. The number of items in a response may be smaller due to paging
    int totalResults?;
    # The actual list of objects
    WeaviateObject[] objects?;
    Deprecation[] deprecations?;
};

# Scaling actions for a single shard, including which nodes to remove and which to add. Nodes listed in 'removeNodes' cannot appear as targets in 'addNodes' for the same shard. If a source node is also marked for removal, it is treated as a move operation and can only appear once as a source node in that shard. A source node that is not being removed can appear multiple times as a source node for additions in that shard (copy operations)
public type ReplicationScalePlanShardScaleActions record {
    # List of node identifiers from which replicas of this shard should be removed. Nodes listed here must not appear in 'addNodes' for the same shard, and cannot be used as a source node for any addition in this shard except in the implicit move case, where they appear as both a source and a node to remove
    string[] removeNodes?;
    # A mapping of target node identifiers to their addition configuration. Each key represents a target node where a new replica will be added. The value may be null, which means an empty replica will be created, or a string specifying the source node from which shard data will be copied. If the source node is also marked for removal in the same shard, this addition is treated as a move operation, and that source node can only appear once as a source node for that shard. If the source node is not being removed, it can be used as the source for multiple additions (copy operations)
    record {|string?...;|} addNodes?;
};

public type WhereFilterGeoRangeDistance record {
    decimal max?;
};

public type Collection record {
    # Specify how the vectors for this collection should be determined. The options are either `none` - this means you have to import a vector with each object yourself - or the name of a module that provides vectorization capabilities, such as `text2vec-weaviate`. If left empty, it will use the globally configured default ([`DEFAULT_VECTORIZER_MODULE`](https://docs.weaviate.io/deploy/configuration/env-vars)) which can itself either be `none` or a specific module
    string vectorizer?;
    # Configure the inverted index built into Weaviate. See [Reference: Inverted index](https://docs.weaviate.io/weaviate/config-refs/indexing/inverted-index#inverted-index-parameters) for details
    InvertedIndexConfig invertedIndexConfig?;
    # Configuration related to multi-tenancy within a collection (class)
    MultiTenancyConfig multiTenancyConfig?;
    # Configure how replication is executed in a cluster
    ReplicationConfig replicationConfig?;
    # Description of the collection for metadata purposes
    string description?;
    # Manage how the index should be sharded and distributed in the cluster
    record {} shardingConfig?;
    # Configuration specific to modules in a collection context
    record {} moduleConfig?;
    # Vector-index config, that is specific to the type of index selected in vectorIndexType
    record {} vectorIndexConfig?;
    # Configuration of objects' time-to-live
    ObjectTtlConfig objectTtlConfig?;
    # Name of the vector index type to use for the collection (e.g. `hnsw` or `flat`)
    string vectorIndexType?;
    # Configure named vectors. Either use this field or `vectorizer`, `vectorIndexType`, and `vectorIndexConfig` fields. Available from `v1.24.0`
    record {|VectorConfig...;|} vectorConfig?;
    # Name of the collection (formerly 'class') (required). Multiple words should be concatenated in CamelCase, e.g. `ArticleAuthor`
    string 'class?;
    # Define properties of the collection
    Property[] properties?;
};

# Request body for the hybrid search endpoint. Combines a keyword (BM25F) search and a vector search over the same query string, fusing both rankings into one result list. Extends the shared search fields (`SearchCommon`) with the hybrid-specific `query`, `alpha`, `fusionType`, `maxVectorDistance`, `queryProperties` and `targetVector`
public type SearchHybridRequest record {
    *SearchCommon;
    # The algorithm that fuses the keyword and vector rankings: `ranked` (reciprocal-rank fusion) or `relativeScore` (normalized-score fusion). Omitted defaults to `relativeScore`
    "ranked"|"relativeScore" fusionType?;
    # The query, as a plain string. It is scored with BM25F for the keyword part of the search and vectorized server-side for the vector part. Must not be empty
    string query;
    # The weight of the vector part of the search, between 0 and 1. `0` is a pure keyword search, `1` a pure vector search. Omitted defaults to `0.75`. With `0` the query is never vectorized, so a collection without a vectorizer module is searchable
    decimal? alpha?;
    # The properties the keyword part of the search scores against, each optionally weighted with a `^boost` suffix (e.g. `title^2`). Omitted or empty searches every searchable text property. A property without a searchable index is rejected with 422
    string[] queryProperties?;
    # The named vector to search. Required when the collection has more than one named vector
    string targetVector?;
    # The maximum vector distance of a match: objects farther than this from the query vector are excluded, from the keyword ranking too
    decimal? maxVectorDistance?;
};

public type IndexStatusResponse record {
    string collection?;
    PropertyIndexStatus[] properties?;
};

# Represents the Queries record for the operation: listCollectionNodes
public type ListCollectionNodesQueries record {
    # Controls the verbosity of the output, possible values are: `minimal`, `verbose`. Defaults to `minimal`
    string output = "minimal";
    string shardName?;
};

# The full set of database-user credential records on the source, one per user
public type UserExportResponse record {
    DBUserCredential[] users;
};

# The definition of a backup node status response body
public type NodeStatus record {
    # Which mode of operation the node is running in
    "ReadWrite"|"WriteOnly"|"ReadOnly"|"ScaleOut" operationalMode?;
    # The list of the shards with it's statistics
    NodeShardStatus[] shards?;
    # The gitHash of Weaviate
    string gitHash?;
    # The summary of Weaviate's statistics
    NodeStats stats?;
    # The name of the node
    string name?;
    # The summary of a nodes batch queue congestion status
    BatchStats batchStats?;
    # The version of Weaviate
    string version?;
    # Node's status
    "HEALTHY"|"UNHEALTHY"|"UNAVAILABLE"|"TIMEOUT" status = "HEALTHY";
};

# A list of pairs of strings that should be replaced with another string during tokenization
public type TokenizerUserDictConfig record {
    TokenizerUserDictConfigReplacements[] replacements?;
    # The tokenizer to which the user dictionary should be applied. Currently, only the `kagame` ja and kr tokenizers supports user dictionaries
    string tokenizer?;
};

# Request body for the aggregate endpoint. Phase 1 supports counts: the number of matching objects, in total or per group. Unknown fields are ignored (platform parity with the other endpoints). Reserved fields are accepted by the schema but rejected by the server with 422 until the corresponding feature ships. An empty body `{}` returns the collection's total object count
public type AggregateRequest record {
    # Reserved for aggregate-over-search (aggregating the results of a vector, keyword or hybrid search). Returns 422 (not yet supported)
    record {}? over?;
    # Reserved for aggregate-over-search (the maximum number of search results to aggregate). Returns 422 (not yet supported)
    int? objectLimit?;
    # The maximum number of groups to return, largest first. Must be positive and requires `groupBy`; omitted falls back to the server default (100 groups)
    int? 'limit?;
    # Filter search results using a where filter
    WhereFilter 'where?;
    # The property to group by, as a bare property name. Each distinct value of the property forms one group (an object whose property holds several values counts toward each of them). Omitted or empty aggregates over all matching objects without grouping
    string groupBy?;
    # The tenant to aggregate in a multi-tenant collection
    string tenant?;
    # The aggregation metrics to return. Phase 1 supports only `count` (the number of matching objects, per group when `groupBy` is set); omitted or empty is equivalent to `["count"]`. The property-scoped `property:statistic` grammar (e.g. `price:mean`) is reserved and returns 422 (not yet supported)
    string[] returnMetrics?;
};

public type BatchReferenceResponse record {
    *BatchReference;
    # Results for this specific reference
    BatchReferenceResponse_result result?;
};

# Represents the Queries record for the operation: rebuildPropertyIndex
public type RebuildPropertyIndexQueries record {
    # Tenant names to target. Allowed for all index types on multi-tenant collections (rebuilds are format-only). Omit to target all tenants
    string[] tenants?;
};

public type ErrorResponseError record {
    string message?;
};

public type ObjectsGetResponse record {
    *WeaviateObject;
    *ObjectsGetResponseDeprecations;
    *ObjectsGetResponseResultWrapper;
};

# Represents the Queries record for the operation: createObject
public type CreateObjectQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
};

# Represents the Queries record for the operation: getBackupStatus
public type GetBackupStatusQueries record {
    # Optional: Specifies the bucket, container, or volume name if required by the backend
    string bucket?;
    # Optional: Specifies the path within the bucket/container/volume if the backup is not at the root
    string path?;
};

# Attributes representing a single tenant within Weaviate
public type Tenant record {
    # The name of the tenant (required)
    string name?;
    # The activity status of the tenant, which determines if it is queryable and where its data is stored.
    # 
    # <b>Available Statuses:</b>
    # - `ACTIVE`: The tenant is fully operational and ready for queries. Data is stored on local, hot storage.
    # - `INACTIVE`: The tenant is not queryable. Data is stored locally.
    # - `OFFLOADED`: The tenant is inactive and its data is stored in a remote cloud backend.
    # 
    # <b>Usage Rules:</b>
    # - <b>On Create:</b> This field is optional and defaults to `ACTIVE`. Allowed values are `ACTIVE` and `INACTIVE`.
    # - <b>On Update:</b> This field is required. Allowed values are `ACTIVE`, `INACTIVE`, and `OFFLOADED`.
    # 
    # <b>Read-Only Statuses:</b>
    # The following statuses are set by the server and indicate a tenant is transitioning between states:
    # - `OFFLOADING`
    # - `ONLOADING`
    # 
    # <b>Note on Deprecated Names:</b>
    # For backward compatibility, deprecated names are still accepted and are mapped to their modern equivalents: `HOT` (now `ACTIVE`), `COLD` (now `INACTIVE`), `FROZEN` (now `OFFLOADED`), `FREEZING` (now `OFFLOADING`), `UNFREEZING` (now `ONLOADING`)
    "ACTIVE"|"INACTIVE"|"OFFLOADED"|"OFFLOADING"|"ONLOADING"|"HOT"|"COLD"|"FROZEN"|"FREEZING"|"UNFREEZING" activityStatus?;
};

# One group of a grouped aggregation: the group's identity under `groupedBy` and its aggregated metrics (phase 1: `count`)
public type AggregateGroup record {
    # The identity of one group: the `groupBy` property (as a one-element path) and the property value that formed the group
    AggregateGroupedBy groupedBy;
    # The number of objects in the group
    int count;
};

# Represents the Queries record for the operation: listCollectionShards
public type ListCollectionShardsQueries record {
    # The name of the tenant for which to retrieve shard statuses (only applicable for multi-tenant collections)
    string tenant?;
};

public type ObjectsGetResponseDeprecations record {
    Deprecation[] deprecations?;
};

# Desired index configuration for `PUT /v1/schema/{className}/properties/{propertyName}/index/{indexType}`. The server diffs the body against the current state and either creates the index, migrates its configuration, or returns a NO_OP. Only fields relevant to the target index type are honored: `tokenization` applies to `searchable`/`filterable`, `algorithm` applies to `searchable`. `rangeFilters` takes no config fields. An empty body `{}` is valid and means "ensure the index exists with its current/default config". At most one configuration change may be requested per call (a body implying both a tokenization and an algorithm change is rejected)
public type IndexUpsertRequest record {
    # Target tokenization for a `searchable` or `filterable` index. Required when creating a `searchable` index; optional otherwise (omitted = keep the current value). On `filterable` creation it must be omitted or equal the property's current tokenization
    string tokenization?;
    # Target BM25 algorithm for a `searchable` index. Only `blockmax` is a valid target (input aliases `block-max`, `block_max`, `blockmaxwand`, `bmw` are accepted case-insensitively). From WAND this triggers the Map → BlockMax migration; on an already-`blockmax` index it is a NO_OP. `wand` is rejected (deprecated); downgrade is intentionally not supported
    string algorithm?;
};

public type PropertyIndexStatus record {
    IndexStatus[] indexes?;
    string dataType?;
    string name?;
    string description?;
};

# The definition of a backup create response body
public type BackupListResponse BackupListResponseInner[];

# Represents the Queries record for the operation: getGroupRoles
public type GetGroupRolesQueries record {
    # If true, the response will include the full role definitions with all associated permissions. If false, only role names are returned
    boolean includeFullRoles = false;
};

# The status of all the shards of a Class
public type ShardStatusList ShardStatusGetResponse[];

# The definition of a backup create metadata
public type BackupCreateStatusResponse record {
    # Destination path of backup files valid for the selected backend
    string path?;
    # Timestamp when the backup process completed (successfully or with failure)
    string completedAt?;
    # Size of the backup in Gibs
    decimal size?;
    # Timestamp when the backup process started
    string startedAt?;
    # Backup backend name e.g. filesystem, gcs, s3
    string backend?;
    # The ID of the backup. Must be URL-safe and work as a filesystem path, only lowercase, numbers, underscore, minus characters allowed
    string id?;
    # error message if creation failed
    string 'error?;
    # The ID of the base backup this incremental backup was built on; empty if the backup is not incremental
    @jsondata:Name {value: "incremental_base_backup_id"}
    string incrementalBaseBackupId?;
    # phase of backup creation process
    "STARTED"|"TRANSFERRING"|"TRANSFERRED"|"FINALIZING"|"SUCCESS"|"FAILED"|"CANCELLING"|"CANCELED" status = "STARTED";
};

public type OidcConfiguration record {
    # The OAuth Client ID configured for Weaviate
    string clientId?;
    # The OIDC issuer URL to redirect to for authentication
    string href?;
    # The required OAuth scopes for authentication
    string[] scopes?;
};

# Represents the Queries record for the operation: getObject
public type GetObjectQueries record {
    # Include additional information, such as classification information. Allowed values include: `classification`, `vector` and `interpretation`
    string include?;
};

public type RemoveRolePermissionsRequest record {
    # Permissions to remove from the role
    Permission[] permissions;
};

# Represents the mapping between an alias name and a collection. An alias provides an alternative name for accessing a collection
public type Alias record {
    # The unique name of the alias that serves as an alternative identifier for the collection
    string alias?;
    # The name of the collection (class) to which this alias is mapped
    string 'class?;
};

# Represents the Queries record for the operation: replaceObject
public type ReplaceObjectQueries record {
    # Determines how many replicas must acknowledge a request before it is considered successful
    @http:Query {name: "consistency_level"}
    string consistencyLevel?;
};

# Outlines how to find the objects to be deleted
public type BatchDeleteMatch record {
    # Filter search results using a where filter
    WhereFilter 'where?;
    # The name of the collection (class) from which to delete objects
    string 'class?;
};

# Defines a complete plan for scaling replication within a collection. Each shard entry specifies nodes to remove and nodes to add. Added nodes may either be initialized empty (null) or created by replicating data from a source node specified as a string. If a source node is also marked for removal in the same shard, it represents a move operation and can only be used once as a source for that shard. If a source node is not marked for removal, it represents a copy operation and can be used as the source for multiple additions in that shard. Nodes listed in 'removeNodes' cannot also appear as targets in 'addNodes' for the same shard, and the same node cannot be specified for both addition and removal in a single shard
public type ReplicationScalePlan record {
    # A mapping of shard names to their corresponding scaling actions. Each key corresponds to a shard name, and its value defines which nodes should be removed and which should be added for that shard. If a source node listed for an addition is also in 'removeNodes' for the same shard, that addition is treated as a move operation. Such a node can appear only once as a source in that shard. Otherwise, if the source node is not being removed, it represents a copy operation and can be referenced multiple times as a source for additions
    record {|ReplicationScalePlanShardScaleActions...;|} shardScaleActions;
    # A unique identifier for this replication scaling plan, useful for tracking and auditing purposes
    string planId;
    # The name of the collection to which this replication scaling plan applies
    string collection;
};
