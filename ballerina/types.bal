    # If the group contains OIDC or database users
    GroupType groupType?;
    # The roles to revoke from the specified group
    string[] roles?;
};

public type WeaviateObject record {
    # A map of named vectors for multi-vector representations
    Vectors vectors?;
    # (Response only) Additional meta information about a single object
    AdditionalProperties additional?;
    # (Response only) Timestamp of the last object update in milliseconds since epoch UTC
    int lastUpdateTimeUnix?;
    # A vector representation of the object in the Contextionary. If provided at object creation, this wil take precedence over any vectorizer setting
    C11yVector vector?;
    # The UUID of the object
    string id?;
    # (Response only) Timestamp of creation of this object in milliseconds since epoch UTC
    int creationTimeUnix?;
    # Name of the collection (class) the object belongs to
    string 'class?;
    # Allow custom overrides of vector weights as math expressions. E.g. `pancake`: `7` will set the weight for the word pancake to 7 in the vectorization, whereas `w * 3` would triple the originally calculated word. This is an open object, with OpenAPI Specification 3.0 this will be more detailed. See Weaviate docs for more info. In the future this will become a key/value (string/string) object
    VectorWeights vectorWeights?;
    # Names and values of an individual property. A returned response may also contain additional metadata, such as from classification or feature projection
    PropertySchema properties?;
    # The name of the tenant the object belongs to
    string tenant?;
};

# The summary of Weaviate's statistics
public type NodeStats record {
    # The total number of objects in DB
    decimal objectCount?;
    # The count of Weaviate's shards. To see this value, set `output` to `verbose`
    decimal shardCount?;
};

# Represents the Queries record for the operation: upsertPropertyIndex
public type UpsertPropertyIndexQueries record {
    # Tenant names to target. Never valid on PUT: every migration this endpoint can submit is semantic, and semantic migrations are always cluster-wide, so passing tenants is rejected with a `400`. Tenant scoping remains available on the `/rebuild` variant
    string[] tenants?;
};

# Response for the POST /replication/scale endpoint containing the list of initiated shard copy operation IDs
public type ReplicationScaleApplyResponse record {
    # List of shard copy operation IDs created during scaling
    string[] operationIds;
    # The unique identifier of the replication scaling plan that generated these operations
    string planId;
    # The name of the collection associated with this replication scaling plan
    string collection;
};

# Manage classifications, trigger them and view status of past classifications
public type Classification record {
    # Classification-type specific settings
    record {} settings?;
    # Additional information to a specific classification
    ClassificationMeta meta?;
    # Base the text-based classification on these fields (of type text)
    string[] basedOnProperties?;
    # ID to uniquely identify this classification run
    string id?;
    ClassificationFilters filters?;
    # Which algorithm to use for classifications
    string 'type?;
    # Error message if status == failed
    string 'error = "";
    # The name of the collection (class) which is used in this classification
    string 'class?;
    # Which ref-property to set as part of the classification
    string[] classifyProperties?;
    # Status of this classification
    "running"|"completed"|"failed" status?;
};

